---
import Logo from './Logo.astro';
import { SIMULATOR_ID } from '../data/landing';
---
<footer class="pied">
  <div class="pied__interieur">
    <div class="pied__marque">
      <Logo size={30} class="pied__logo" />
      <p class="pied__statut">Application en préparation</p>
    </div>
    <a class="pied__retour" href={`#${SIMULATOR_ID}`}>Revenir au simulateur <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .pied {
    border-top: 1px solid var(--filet);
  }

  .pied__interieur {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: 2rem var(--page-x) 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .pied__marque {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pied__marque :global(.pied__logo) {
    width: auto;
    height: 26px;
  }

  .pied__statut {
    font: 500 0.875rem/1.4 var(--font-texte);
    color: var(--legende);
  }

  .pied__retour {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: var(--cible);
    border-radius: 4px;
    font: 600 0.9375rem/1.2 var(--font-texte);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 60em) {
    .pied__interieur {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 2.5rem var(--page-x) 3rem;
    }

    .pied__marque {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }

    .pied__marque :global(.pied__logo) {
      height: 30px;
    }
  }
</style>
