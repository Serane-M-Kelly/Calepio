---
/**
 * Emplacement provisoire du simulateur (phase 2 : composant React en client:load).
 * Aucun champ, aucun bouton de calcul, aucun montant : seulement la méthode,
 * les cinq poches et les limites. L'identifiant #simulateur reste stable.
 */
import { pockets, SIMULATOR_ID } from '../data/landing';
---
<section class="simulateur" id={SIMULATOR_ID} aria-labelledby="simulateur-titre">
  <div class="simulateur__interieur">
    <h2 id="simulateur-titre" class="titre-section">À toi de répartir ton budget.</h2>

    <div class="simulateur__grille">
      <div class="simulateur__annonce">
        <p class="etiquette">En préparation</p>
        <p class="simulateur__statut">
          Le simulateur est en cours de réalisation. Cette zone ne calcule encore rien et ne
          demande aucune saisie.
        </p>
        <div class="simulateur__methode">
          <h3 class="sous-titre">Comment la répartition sera préparée</h3>
          <ol class="ordre">
            <li>Tu indiques tes revenus du mois.</li>
            <li>Tu peux choisir une enveloppe, un plafond charges comprises. Sans enveloppe, tout le revenu est réparti.</li>
            <li>Tes charges sont réservées à leur montant exact.</li>
            <li>Le disponible est réparti entre les cinq poches par tranches de 5&nbsp;€.</li>
          </ol>
        </div>
        <div class="simulateur__limites">
          <h3 class="sous-titre">Avant tes premières dépenses</h3>
          <p>
            Cette simulation prépare un mois avant ses premières dépenses. Elle ne prend pas en
            compte les factures déjà payées, les avances ou les reports du mois précédent.
            Calepio ne déplace pas d’argent.
          </p>
        </div>
      </div>

      <div class="poches">
        <h3 class="poches__titre">Les cinq poches</h3>
        <ul class="poches__liste">
          {
            pockets.map((pocket) => (
              <li class="poche">
                <span class={`compartiment c-${pocket.id}`} aria-hidden="true" />
                <span class="poche__texte">
                  <span class="poche__nom">{pocket.label}</span>
                  <span class="poche__description">{pocket.description}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <p class="poches__note">Tu effectues ensuite les transferts dans ton application bancaire.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .simulateur {
    scroll-margin-top: 1rem;
  }

  .simulateur__interieur {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: 2rem var(--page-x) 2.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .simulateur__interieur::before {
    content: '';
    display: block;
    border-top: 1px solid rgba(34, 32, 46, 0.15);
    margin-bottom: -0.25rem;
  }

  .simulateur__grille {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .simulateur__annonce {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .etiquette {
    display: inline-flex;
    align-items: center;
    padding: 0.4375rem 0.625rem;
    border: 1.5px solid var(--encre);
    border-radius: 999px;
    font: 700 0.875rem/1 var(--font-texte);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .simulateur__statut {
    font-size: var(--fs-intro);
    line-height: 1.5;
    color: var(--texte-2);
    max-width: 36rem;
    text-wrap: pretty;
  }

  .sous-titre {
    font: 700 1.25rem/1.2 var(--font-titre);
    letter-spacing: -0.01em;
  }

  .simulateur__methode,
  .simulateur__limites {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 36rem;
  }

  .ordre {
    margin: 0;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--texte-2);
  }

  .ordre li::marker {
    font-weight: 700;
    color: var(--encre);
  }

  .simulateur__limites p {
    color: var(--texte-2);
    text-wrap: pretty;
  }

  /* Carte des poches : surface claire, sans courbe de résultat. */
  .poches {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--filet-fort);
    border-radius: 20px 8px 8px 20px;
  }

  .poches__titre {
    font: 700 1.25rem/1.2 var(--font-titre);
    letter-spacing: -0.01em;
  }

  .poches__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--encre);
  }

  .poche {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--filet);
  }

  .poche .compartiment {
    margin-top: 0.25rem;
  }

  .poche__texte {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .poche__nom {
    font: 600 1rem/1.3 var(--font-texte);
  }

  .poche__description {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--texte-2);
  }

  .poches__note {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--legende);
  }

  @media (min-width: 60em) {
    .simulateur__interieur {
      padding: 3rem var(--page-x) 7rem;
      gap: 3rem;
    }

    .simulateur__interieur::before {
      margin-bottom: -1rem;
    }

    .simulateur__grille {
      grid-template-columns: minmax(0, 600fr) minmax(0, 528fr);
      gap: clamp(2.5rem, 5.5vw, 5rem);
    }

    .poches {
      padding: 2.25rem;
    }

    .poche__nom {
      font-size: 1.0625rem;
    }
  }
</style>
